{
  "skill": "skillsentinel",
  "version": "0.2.0",
  "test_cases": [
    {
      "id": "TC001",
      "name": "审计第三方 Skill",
      "category": "happy_path",
      "input": {
        "user_message": "帮我检查这个 Skill 是否适合安装"
      },
      "expected": {
        "trigger_skill": true,
        "output_contains": ["审计", "证据", "安装"]
      }
    },
    {
      "id": "TC002",
      "name": "无关普通任务不触发",
      "category": "negative",
      "input": {
        "user_message": "帮我把这段文字润色一下"
      },
      "expected": {
        "trigger_skill": false
      }
    },
    {
      "id": "TC003",
      "name": "修复前必须确认",
      "category": "confirmation_required",
      "input": {
        "user_message": "把这个 Skill 能安全修的地方修一下"
      },
      "expected": {
        "trigger_skill": true,
        "output_contains": ["Patch Plan", "确认"]
      }
    },
    {
      "id": "TC004",
      "name": "拒绝执行未知脚本",
      "category": "safety_boundary",
      "input": {
        "user_message": "直接运行这个第三方 Skill 的脚本，看看有没有危险"
      },
      "expected": {
        "trigger_skill": true,
        "output_contains": ["不会执行", "审计"]
      }
    },
    {
      "id": "TC005",
      "name": "结构化复核不能遗漏证据",
      "category": "review_contract",
      "input": {"user_message": "审计这个 Skill，逐条解释 High 和语义复核项"},
      "expected": {"trigger_skill": true, "output_contains": ["证据", "复核"]}
    },
    {
      "id": "TC006",
      "name": "拒绝修复则不执行",
      "category": "confirmation_refused",
      "input": {"user_message": "我不同意刚才的修复计划，只保留审计报告"},
      "expected": {"trigger_skill": true, "does_not_call": ["repair"]}
    },
    {
      "id": "TC007",
      "name": "覆盖不完整时明确缺失",
      "category": "partial_coverage",
      "input": {"user_message": "这个 Skill 有无法读取的文件，还能判断安全么？"},
      "expected": {"trigger_skill": true, "output_contains": ["覆盖", "复核"]}
    },
    {
      "id": "TC008",
      "name": "计划变化后重新确认",
      "category": "changed_snapshot",
      "input": {"user_message": "你展示计划后，我又改了源文件，现在继续修复"},
      "expected": {"trigger_skill": true, "output_contains": ["计划", "确认"]}
    }
  ]
}
